---
import '../styles/global.css';
const { title = 'Platform Atlas', reading = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="An interactive map of Food Intelligence Platform: follow workflows, explore source files, API routes and database relationships." />
    <meta name="theme-color" content="#153c35" />
    <title>{title} · Food Intelligence Platform</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <aside class="sidebar">
      <a href="/" class="brand" aria-label="Platform Atlas home"><span class="brand-mark">f<span>i</span></span><span>food intelligence<span class="brand-sub">PLATFORM ATLAS</span></span></a>
      <div class="sidebar-label">EXPLORE THE SYSTEM</div>
      <nav aria-label="Portal navigation">
        <a href="/#map" data-view="map"><span class="nav-icon">⌘</span> World map <span class="nav-count">01</span></a>
        <a href="/#workflows" data-view="workflows"><span class="nav-icon">⇢</span> Follow a workflow <span class="nav-count">02</span></a>
        <a href="/#files" data-view="files"><span class="nav-icon">▤</span> File explorer <span class="nav-count">03</span></a>
        <a href="/#api" data-view="api"><span class="nav-icon">↔</span> API directory <span class="nav-count">04</span></a>
        <a href="/#database" data-view="database"><span class="nav-icon">▱</span> Database map <span class="nav-count">05</span></a>
        <a href="/#docs" data-view="docs" class:list={{active:reading}}><span class="nav-icon">▧</span> Field guide <span class="nav-count">06</span></a>
      </nav>
      <div class="sidebar-bottom">
        <div class="scope-pill"><span class="dot"></span> Platform MVP · mapped</div>
        <p>A map for understanding.<br/>Follow the connections.<br/>Find where to look next.</p>
        <a href="/#risks" data-view="risks" class="review-link">◌ &nbsp; Known audit gaps <span>↗</span></a>
        <div class="sidebar-version">ASTRO 7 <span>DOCUMENTATION ONLY</span></div>
      </div>
    </aside>
    <div class="workspace">
      <header class="topbar"><div class="breadcrumb">food-intelligence-platform <span>/</span> <strong id="breadcrumb">{reading ? 'Field guide' : 'Architecture'}</strong></div><div class="topbar-right"><a href="https://github.com/jobayermannan/food-intelligence-platform" target="_blank" rel="noreferrer">Repository ↗</a><span class="local-badge">LOCAL EXPLORER</span></div></header>
      <main id="main"><slot /></main>
      <footer class="site-footer">Food Intelligence Platform <span>Read the map. Trace the flow. Understand the system.</span></footer>
    </div>
  </body>
</html>
