# Vercel web project build variable. Use the stable production URL of the
# separate Vercel API project; Next.js embeds this rewrite destination at build time.
API_ORIGIN=https://food-intelligence-api.vercel.app

# Vercel API project runtime variables
NODE_ENV=production
# Neon pooled runtime connection. Keep sslmode=require and use the -pooler host.
DATABASE_URL=postgresql://production_user:replace-me@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Optional. Defaults to 4 on Vercel Functions and 12 elsewhere.
DATABASE_POOL_MAX=4
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=food-intelligence-platform
JWT_AUDIENCE=food-intelligence-api
APP_ORIGIN=https://app.example.com
# Optional comma-separated exact origins; when set, this overrides APP_ORIGIN.
APP_ORIGINS=
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
SWAGGER_ENABLED=false

# Production email provider. For STARTTLS on port 587, keep SMTP_SECURE=false
# and SMTP_REQUIRE_TLS=true. For implicit TLS on port 465, use true/false.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=replace-with-provider-username
SMTP_PASSWORD=replace-with-provider-password
MAIL_FROM=Food Intelligence <no-reply@example.com>

# Migration operator/CI only: do not configure this in the Vercel API project.
# Run `npm run db:migrate` with DATABASE_URL set to Neon's direct TLS URL.
# postgresql://production_user:replace-me@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Docker remains a fallback deployment path. Its web image accepts API_ORIGIN as
# a build argument and its API image starts with the standard PORT setting.
