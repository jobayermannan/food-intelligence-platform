# Development values only. Replace secrets before exposing the API.
PORT=3000
# Host port used only by Docker Compose. Set this (for example, to 3100)
# when another local project already uses 3000.
API_HOST_PORT=3000
DATABASE_URL=postgres://food:food_dev_only@localhost:5434/food_intelligence
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=food-intelligence-platform
JWT_AUDIENCE=food-intelligence-api
APP_ORIGIN=http://localhost:3001
COOKIE_SECURE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=development@food-intelligence.local
