# Development values only. Replace secrets before exposing the API.
PORT=3000
# Host port used only by Docker Compose. Set this (for example, to 3100)
# when another local project already uses 3000.
API_HOST_PORT=3000
DATABASE_URL=postgres://food:food_dev_only@localhost:5434/food_intelligence
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=food-intelligence-platform
JWT_AUDIENCE=food-intelligence-api
APP_ORIGIN=http://localhost:3001
# Optional comma-separated exact origins; overrides APP_ORIGIN when nonempty.
# Local LAN example: http://localhost:3001,http://192.168.0.103:3001
# Production: leave empty and set APP_ORIGIN to the exact HTTPS origin.
APP_ORIGINS=
# false is for local HTTP development only; use true with production HTTPS.
COOKIE_SECURE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
# Leave both empty for Mailpit. Configure both for an authenticated SMTP provider.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=development@food-intelligence.local
